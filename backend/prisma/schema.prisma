generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum Role {
  PATIENT
  CLINICIAN
}

enum SymptomType {
  BREAST_PAIN
  LUMP_DETECTED
  SKIN_CHANGES
  NIPPLE_DISCHARGE
  SWELLING
  FATIGUE
  OTHER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role
  patientId String?  @unique
  patient   Patient? @relation(fields: [patientId], references: [id])
  createdAt DateTime @default(now())
}

model Patient {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  middleName  String?
  dateOfBirth DateTime
  sex         Sex
  phone       String
  email       String
  country     String
  city        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  symptoms SymptomEntry[]
  user     User?

  @@index([createdAt])
}

model SymptomEntry {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  symptomType SymptomType
  severity    Int
  occurredAt  DateTime
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([occurredAt])
  @@index([severity])
  @@index([patientId, occurredAt])
}
